# Veřejná URL webu (pro OG metadata a sitemap)
NEXT_PUBLIC_SITE_URL=https://docasnyvykup.cz

# EmailJS – stejné hodnoty jako projekt hnedpenize (šablony template_ypewbii / template_3t8h00d).
# Důležité: `output: "export"` — NEXT_PUBLIC_* se vkládají do JS už při `npm run build`. Bez nich odeslání skončí chybou.
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=fVG_yHeKHdIXYO1x0
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_gxzios3
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_ypewbii
# Klientská potvrzovací šablona; výchozí template_3t8h00d pokud není nastaveno v kódu
NEXT_PUBLIC_EMAILJS_CLIENT_TEMPLATE_ID=template_3t8h00d

# Analytics: stejný model jako hnedpenize — GTM + Google Ads gtag + volitelné GA4 (gtag).
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-KLXJB44J
# Google Analytics 4 (např. G-XXXXXXXXXX). Po úspěšném EmailJS: vyplneny_formular nebo telefonni_cislo.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — výchozí AW jako hnedpenize; přepsat přes NEXT_PUBLIC_GOOGLE_ADS_AW_ID.
# NEXT_PUBLIC_GOOGLE_ADS_AW_ID=AW-XXXXXXXXXX
# Volitelné: konverze leadu (AW-…/label). Jen pokud neimportujete GA4 události do Ads.
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_SEND_TO=AW-XXXXXXXXXX/XXXXXXXXXXXX
