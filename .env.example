# Veřejná URL webu (pro OG metadata a sitemap)
NEXT_PUBLIC_SITE_URL=https://docasnyvykup.cz

# EmailJS (https://www.emailjs.com/) – šablony musí odpovídat polím v lib/emailjs.ts
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Volitelné: šablona potvrzení pro klienta po odeslání formuláře (pouze u poptávky s e-mailem)
# NEXT_PUBLIC_EMAILJS_CLIENT_TEMPLATE_ID=

# Volitelné: Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
