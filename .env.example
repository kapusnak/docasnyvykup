# Veřejná URL webu (pro OG metadata a sitemap)
NEXT_PUBLIC_SITE_URL=https://docasnyvykup.cz

# SMTP (Spacemail / vlastní schránka) — jen na serveru (Railway Variables). Nikdy NEXT_PUBLIC_*.
# Host: mail.spacemail.com | Port: 465 (SSL) nebo 587 (STARTTLS)
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=lead@docasnyvykup.cz
SMTP_PASS=
# Příjemce notifikací o nových poptávkách (může být stejná schránka nebo Gmail)
LEAD_NOTIFY_TO=lead@docasnyvykup.cz
# Volitelně: From hlavička. Bez ní: "docasnyvykup.cz" <SMTP_USER> (v inboxu se ukáže doména, ne "info"/"lead")
# MAIL_FROM="docasnyvykup.cz <lead@docasnyvykup.cz>"

# Analytics: GTM + Google Ads gtag + volitelné GA4 (gtag).
# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-KLXJB44J
# Google Analytics 4 (např. G-XXXXXXXXXX). Po úspěšném odeslání: vyplneny_formular nebo telefonni_cislo.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — výchozí AW; přepsat přes NEXT_PUBLIC_GOOGLE_ADS_AW_ID.
# NEXT_PUBLIC_GOOGLE_ADS_AW_ID=AW-XXXXXXXXXX
# Volitelné: konverze leadu (AW-…/label). Jen pokud neimportujete GA4 události do Ads.
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_CONVERSION_SEND_TO=AW-XXXXXXXXXX/XXXXXXXXXXXX
